# OS and editor leftovers at the repository root
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# Local secrets. Only the machine that wrote one should ever hold it.
.env
.env.*

# Tooling caches if Flutter or Python is run from the repo root
.dart_tool/
**/chrome-device/
__pycache__/
*.pyc

# Logs
*.log

# Browser audit sessions and screenshots stay on the reviewing device.
/.playwright-cli/
/output/playwright/

# Backend build output. The source and the lockfile stay tracked.
backend/node_modules/
backend/dist/

# Test suites stay local (frontend/test and frontend/integration_test are
# ignored in frontend/.gitignore), as does local agent configuration.
backend/test/
/.claude/

# Operator-captured photos and local app data. Branding and icons stay
# tracked.
/Tapture/
**/photos/
*.jpg
*.jpeg
*.heic
*.heif
*.webp
TAPTURE-*.zip
