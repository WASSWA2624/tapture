+
+typedef _Host = ({
+  FakeContextRepository repo,
+  _MovableClock clock,
+  _MovingLocation location,
+  SettingsStore store,
+});
+
+/// ContextMaintenance over project p1 in one room, with GPS on and location
+/// granted, so only the two settings decide whether anything happens.
+Future<_Host> _pump(
+  WidgetTester tester, {
+  required Map<String, Object?> settings,
+}) async {
+  final FakeContextRepository repo = FakeContextRepository();
+  final FakeProjectRepository projects = FakeProjectRepository();
+  addTearDown(repo.dispose);
+  addTearDown(projects.dispose);
+  _ok(await projects.create(aProject(id: 'p1', name: 'Inventory')));
+  _ok(
+    await repo.saveHierarchy('p1', const <ContextLevel>[
+      ContextLevel(fieldKey: 'district', order: 0, label: 'District'),
+      ContextLevel(fieldKey: 'facility', order: 1, label: 'Facility'),
+      ContextLevel(fieldKey: 'dept', order: 2, label: 'Department'),
+    ]),
+  );
+  for (final (String key, String value) in <(String, String)>[
+    ('district', 'Kampala'),
+    ('facility', 'Kasubi HC IV'),
+    ('dept', 'Theatre'),
+  ]) {
+    _ok(await repo.setLevelValue(projectId: 'p1', fieldKey: key, value: value));
+  }
+  _ok(
+    await repo.savePinned('p1', const <String, String>{
+      'survey_date': '2026-09-29',
+    }),
+  );
+  final _MovableClock clock = _MovableClock(DateTime.utc(2026, 9, 29, 8));
+  final _MovingLocation location = _MovingLocation();
+  final SettingsStore store = SettingsStore.fake(
+    stored: <String, Object?>{
+      SettingKeys.openProjectId.name: 'p1',
+      SettingKeys.gpsEnabled.name: true,
+      ...settings,
+    },
+  );
+  await tester.pumpWidget(
+    ProviderScope(
+      retry: (int _, Object _) => null,
+      overrides: <Override>[
+        contextRepositoryProvider.overrideWith((Ref _) => repo),
+        projectRepositoryProvider.overrideWith((Ref _) => projects),
+        projectSettingsStoreProvider.overrideWithValue(store),
+        contextClockProvider.overrideWith((Ref _) => clock),
+        locationServiceProvider.overrideWith((Ref _) => location),
+        contextPermissionsProvider.overrideWith(
+          (Ref _) => PermissionsService.fake(
+            states: const <AppPermission, PermissionState>{
+              AppPermission.location: PermissionState.granted,
+            },
+            gpsEnabled: () => true,
+          ),
+        ),
+      ],
+      child: MaterialApp(
+        theme: buildTheme(brightness: Brightness.light),
+        home: const ContextMaintenance(child: Scaffold(body: SizedBox())),
+      ),
+    ),
+  );
+  await tester.pumpAndSettle();
+  return (repo: repo, clock: clock, location: location, store: store);
+}
+
+/// A location that moves when the test says so, counting every read.
+final class _MovingLocation implements LocationService {
+  GeoFix fix = _at(0.3476);
+  int calls = 0;
+
+  @override
+  Future<Result<GeoFix?>> currentFix({
+    Duration timeout = AppConstants.locationTimeout,
+  }) async {
+    calls++;
+    return Success<GeoFix?>(fix);
+  }
+}
+
+GeoFix _at(double latitude) {
+  return GeoFix(
+    latitude: latitude,
+    longitude: 32.5825,
+    accuracyMetres: 5,
+    capturedAt: DateTime.utc(2026, 9, 29, 8),
+  );
+}
+
+final class _MovableClock implements Clock {
+  _MovableClock(this._now);
+
+  DateTime _now;
+
+  void advance(Duration by) => _now = _now.add(by);
+
+  @override
+  DateTime nowUtc() => _now;
+
+  @override
+  DateTime today() => DateTime.utc(_now.year, _now.month, _now.day);
+
+  @override
+  Duration get offset => Duration.zero;
+}
+
+T _ok<T>(Result<T> result) {
+  return switch (result) {
+    Success<T>(:final T value) => value,
+    FailureResult<T>(:final Failure failure) => throw TestFailure(
+      failure.message,
+    ),
+  };
+}
