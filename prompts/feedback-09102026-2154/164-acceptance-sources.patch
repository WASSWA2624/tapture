+/// What the capture had durably when its microphone was asked for.
+typedef _AtStart = ({bool staged, bool begun});
+
+/// A fake capture that holds the one microphone through [arbiter], as the
+/// real one does, publishes each take where it was asked to, and records
+/// what was already durable when it was started.
+final class _OwnedCapture implements AudioCaptureService {
+  _OwnedCapture({required this.arbiter, this.onStart});
+
+  /// The process's one microphone owner.
+  final MicrophoneArbiter arbiter;
+
+  /// Reads what was durable at a long-form start.
+  final Future<_AtStart> Function()? onStart;
+
+  /// The capture underneath.
+  final FakeAudioCaptureService inner = FakeAudioCaptureService();
+
+  /// What [onStart] found at the first long-form start.
+  _AtStart? seenAtStart;
+
+  final List<MicrophoneLease> _leases = <MicrophoneLease>[];
+
+  /// The owners whose claim on the microphone was refused, in order.
+  final List<MicrophoneOwner> refused = <MicrophoneOwner>[];
+
+  /// Every request started, in order.
+  List<AudioCaptureRequest> get requests => inner.requests;
+
+  /// The most recent session.
+  FakeAudioCaptureSession? get session => inner.session;
+
+  /// Pushes [samples] into the current session.
+  void push(Int16List samples) => inner.push(samples);
+
+  @override
+  Future<Result<AudioCaptureSession>> start(AudioCaptureRequest request) async {
+    final String? path = request.relativePath;
+    if (path != null) {
+      seenAtStart ??= await onStart?.call();
+    }
+    final Result<MicrophoneLease> claimed = await arbiter.claim(request.owner);
+    switch (claimed) {
+      case FailureResult<MicrophoneLease>(:final Failure failure):
+        refused.add(request.owner);
+        return FailureResult<AudioCaptureSession>(failure);
+      case Success<MicrophoneLease>(:final MicrophoneLease value):
+        _leases.add(value);
+    }
+    if (path != null) {
+      inner.recording = AudioRecording(
+        relativePath: path,
+        sha256: 'take-sha',
+        byteLength: 64044,
+        duration: const Duration(seconds: 10),
+        mimeType: 'audio/wav',
+      );
+    }
+    return inner.start(request);
+  }
+}
+
+T _ok<T>(Result<T> result) {
+  return switch (result) {
+    Success<T>(:final T value) => value,
+    FailureResult<T>(:final Failure failure) => throw TestFailure(
+      failure.message,
+    ),
+  };
+}
