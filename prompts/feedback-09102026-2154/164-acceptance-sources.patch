+    final ContextState cleared = _ok(await host.repo.load('p1'));
+    expect(cleared.values['dept'] ?? '', isEmpty);
+    expect(cleared.values['district'], 'Kampala');
+    expect(cleared.values['facility'], 'Kasubi HC IV');
+    expect(cleared.pinned, before.pinned);
+    expect(
+      find.text(Copy.contextAutoClearMessage('Department')),
+      findsOneWidget,
+    );
