--- /dev/null
+++ b/frontend/test/support/fakes/fake_audio_capture_service.dart
@@ -0,0 +1,160 @@
+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:tapture/core/audio/audio_capture_event.dart';
+import 'package:tapture/core/audio/audio_capture_request.dart';
+import 'package:tapture/core/audio/audio_capture_service.dart';
+import 'package:tapture/core/audio/audio_capture_session.dart';
+import 'package:tapture/core/audio/audio_recording.dart';
+import 'package:tapture/core/audio/capture_format.dart';
+import 'package:tapture/core/audio/capture_pause_reason.dart';
+import 'package:tapture/core/audio/memory_pcm_store.dart';
+import 'package:tapture/core/audio/pcm_chunk.dart';
+import 'package:tapture/core/audio/pcm_store.dart';
+import 'package:tapture/core/errors/failure.dart';
+import 'package:tapture/core/errors/result.dart';
+
+/// A hand-written [AudioCaptureService] driven by the test (FE-TEST-03):
+/// samples are pushed by hand, and an interruption or a lost microphone is
+/// one call. Audio is kept in memory.
+final class FakeAudioCaptureService implements AudioCaptureService {
+  /// A service whose starts fail with [startFailure] when set, and whose
+  /// sessions publish [recording] when they stop.
+  FakeAudioCaptureService({this.startFailure, this.recording});
+
+  /// Returned by every start, when set.
+  Failure? startFailure;
+
+  /// What a stopped session publishes; null for memory-only.
+  AudioRecording? recording;
+
+  /// Every request started, in order.
+  final List<AudioCaptureRequest> requests = <AudioCaptureRequest>[];
+
+  /// The most recent session.
+  FakeAudioCaptureSession? session;
+
+  @override
+  Future<Result<AudioCaptureSession>> start(AudioCaptureRequest request) async {
+    requests.add(request);
+    final Failure? failure = startFailure;
+    if (failure != null) {
+      return FailureResult<AudioCaptureSession>(failure);
+    }
+    final FakeAudioCaptureSession started = FakeAudioCaptureSession(
+      recording: recording,
+    );
+    session = started;
+    return Success<AudioCaptureSession>(started);
+  }
+
+  /// Pushes [samples] into the current session.
+  void push(Int16List samples) => session?.push(samples);
+
+  /// Pauses the current session as a phone call would.
+  void interrupt() => session?.pauseFor(CapturePauseReason.interruption);
+
+  /// Pauses the current session as an unplugged microphone would.
+  void lose() => session?.pauseFor(CapturePauseReason.microphoneLost);
+}
+
+/// A capture session over a [MemoryPcmStore] the test feeds.
+final class FakeAudioCaptureSession implements AudioCaptureSession {
+  /// A session that publishes [recording] when it stops.
+  FakeAudioCaptureSession({this.recording});
+
+  /// What [stop] publishes.
+  final AudioRecording? recording;
+
+  final MemoryPcmStore _store = MemoryPcmStore(maxSamples: 16000 * 60 * 60);
+  final StreamController<PcmChunk> _chunks = StreamController<PcmChunk>();
+  final StreamController<AudioCaptureEvent> _events =
+      StreamController<AudioCaptureEvent>.broadcast();
+  bool _paused = false;
+
+  /// Calls to [checkpoint].
+  int checkpoints = 0;
+
+  /// Whether [stop] ran.
+  bool stopped = false;
+
+  /// Whether [abandon] ran.
+  bool abandoned = false;
+
+  /// Whether [release] ran.
+  bool released = false;
+
+  @override
+  Stream<PcmChunk> get chunks => _chunks.stream;
+
+  @override
+  Stream<AudioCaptureEvent> get events => _events.stream;
+
+  @override
+  int get capturedSamples => _store.length;
+
+  @override
+  PcmStore get store => _store;
+
+  @override
+  CaptureFormat get format =>
+      const CaptureFormat(inputSampleRate: 16000, inputChannels: 1);
+
+  /// Appends [samples] and emits them, unless the session is paused.
+  void push(Int16List samples) {
+    if (_paused || stopped || abandoned) {
+      return;
+    }
+    final int start = _store.length;
+    _store.append(samples);
+    _chunks.add(PcmChunk(start, samples));
+  }
+
+  /// Pauses for [reason] without being asked.
+  void pauseFor(CapturePauseReason reason) {
+    _paused = true;
+    _events.add(CapturePaused(reason: reason, atSample: _store.length));
+  }
+
+  @override
+  Future<Result<void>> pause() async {
+    pauseFor(CapturePauseReason.user);
+    return const Success<void>(null);
+  }
+
+  @override
+  Future<Result<void>> resume() async {
+    if (_paused) {
+      _paused = false;
+      _events.add(CaptureResumed(atSample: _store.length));
+    }
+    return const Success<void>(null);
+  }
+
+  @override
+  Future<Result<void>> checkpoint() async {
+    checkpoints++;
+    return const Success<void>(null);
+  }
+
+  @override
+  Future<Result<AudioRecording?>> stop() async {
+    stopped = true;
+    unawaited(_chunks.close());
+    return Success<AudioRecording?>(recording);
+  }
+
+  @override
+  Future<Result<String?>> abandon() async {
+    abandoned = true;
+    unawaited(_chunks.close());
+    return const Success<String?>(null);
+  }
+
+  @override
+  Future<void> release() async {
+    released = true;
+    _store.close();
+    await _events.close();
+  }
+}
