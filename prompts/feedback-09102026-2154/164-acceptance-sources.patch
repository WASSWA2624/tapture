+    // The first check notes the context; idle time counts from there.
+    await tester.pump(AppConstants.context.checkEvery);
+    host.clock.advance(const Duration(minutes: 2));
+    await tester.pump(AppConstants.context.checkEvery);
+    await tester.pumpAndSettle();
