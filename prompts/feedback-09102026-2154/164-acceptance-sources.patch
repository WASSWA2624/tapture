+  });
+
+  group('the shipped tree as a whole', () {
+    test('lets theme, widgets and AppConstants keep their literals', () {
+      expect(_findTokenViolations(_lib), isEmpty);
+    });
+  });
+
+  test(
+    'runtime durations pass while literal durations still require tokens',
+    () {
+      final Directory root = Directory.systemTemp.createTempSync(
+        'tapture_duration_',
+      );
+      addTearDown(() => root.deleteSync(recursive: true));
+      File('${root.path}/duration.dart').writeAsStringSync('''
+Duration decode(int microseconds) => Duration(microseconds: microseconds);
+Duration literal(int hours) => Duration(
