+  <String>['replace', 'north', 'valve'],
+];
+
+/// Where phrase [index] starts: half a second in, then every four seconds.
+int _phraseStart(int index) =>
+    SpokenScript.samplesOf(const Duration(milliseconds: 500)) +
+    index * SpokenScript.samplesOf(const Duration(seconds: 4));
+
+/// The phrases as a script, and their audio followed by two seconds of room
+/// tone.
+({SpokenScript script, Int16List audio}) _speech() {
+  final SpokenScript script = SpokenScript(<SpokenWord>[
+    for (int index = 0; index < _phrases.length; index++)
+      ...SpokenScript.paced(
+        _phrases[index],
+        startSample: _phraseStart(index),
+      ).words,
+  ]);
+  return (
+    script: script,
+    audio: PcmFixtures.fromScript(
+      script,
+      length:
+          script.endSample + SpokenScript.samplesOf(const Duration(seconds: 2)),
+    ),
+  );
+}
+
+/// Runs until [condition] holds, or fails after many event-loop turns.
+Future<void> _until(bool Function() condition, {String? reason}) async {
+  for (int turn = 0; turn < 4000 && !condition(); turn++) {
+    await pumpEventQueue();
+  }
+  expect(condition(), isTrue, reason: reason);
+}
+
+/// Runs until [condition] completes true, or fails after many turns.
+Future<void> _untilAsync(
+  Future<bool> Function() condition, {
+  String? reason,
+}) async {
+  bool held = await condition();
+  for (int turn = 0; turn < 2000 && !held; turn++) {
+    await pumpEventQueue();
+    held = await condition();
+  }
+  expect(held, isTrue, reason: reason);
+}
+
+/// Lets real work (file reads, the storage check) and frames run in turn
+/// until [condition] holds, or fails after many rounds.
+Future<void> _settle(WidgetTester tester, bool Function() condition) async {
+  for (int round = 0; round < 100 && !condition(); round++) {
+    await tester.runAsync(
+      () => Future<void>.delayed(const Duration(milliseconds: 10)),
+    );
+    await tester.pump(const Duration(milliseconds: 20));
+  }
+  await tester.pump();
+  expect(condition(), isTrue);
+}
