@@ -0,0 +1,76 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tapture/app/theme/app_theme.dart';
+import 'package:tapture/app/theme/dimensions.dart';
+import 'package:tapture/core/widgets/app_card.dart';
+import 'package:tapture/core/widgets/app_page.dart';
+
+import '../../support/a11y_matchers.dart';
+
+void main() {
+  testWidgets('a tap opens a tappable card and a static card ignores taps', (
+    WidgetTester tester,
+  ) async {
+    bool opened = false;
+    await _pump(
+      tester,
+      Column(
+        children: <Widget>[
+          AppCard(onTap: () => opened = true, child: const Text('Review')),
+          const AppCard(child: Text('Static')),
+        ],
+      ),
+    );
+
+    expect(find.byType(AppCard).first, meetsTapTarget());
+    await tester.tap(find.text('Review'));
+    await tester.pump();
+    expect(opened, isTrue);
+
+    opened = false;
+    await tester.tap(find.text('Static'));
+    await tester.pump();
+    expect(opened, isFalse);
+  });
+
+  testWidgets('a card stays usable at 200 percent text scale', (
+    WidgetTester tester,
+  ) async {
+    tester.platformDispatcher.textScaleFactorTestValue = 2;
+    addTearDown(tester.platformDispatcher.clearTextScaleFactorTestValue);
+    await tester.pumpWidget(
+      MaterialApp(
+        theme: buildTheme(brightness: Brightness.light),
+        home: AppPage(
+          title: 'Card',
+          body: AppCard(
+            onTap: () {},
+            child: const Text(
+              'A long detail paragraph that must wrap rather than clip '
+              'the page at two hundred percent text scale.',
+            ),
+          ),
+        ),
+      ),
+    );
+    expect(tester.takeException(), isNull);
+    await expectNoA11yIssues(tester);
+  });
+}
+
+Future<void> _pump(WidgetTester tester, Widget child) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = const Size(400, 800);
+  addTearDown(() {
+    tester.view.resetPhysicalSize();
+    tester.view.resetDevicePixelRatio();
+  });
+  await tester.pumpWidget(
+    MaterialApp(
+      theme: buildTheme(brightness: Brightness.light),
+      home: Scaffold(
+        body: Padding(padding: const EdgeInsets.all(Space.x4), child: child),
+      ),
+    ),
+  );
+}
diff --git a/frontend/test/core/widgets/app_component_padding_test.dart b/frontend/test/core/widgets/app_component_padding_test.dart
new file mode 100644
--- /dev/null
+++ b/frontend/test/core/widgets/app_component_padding_test.dart
@@ -0,0 +1,159 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tapture/app/theme/app_theme.dart';
+import 'package:tapture/app/theme/dimensions.dart';
+import 'package:tapture/core/widgets/app_button.dart';
+import 'package:tapture/core/widgets/app_card.dart';
+import 'package:tapture/core/widgets/app_icon_button.dart';
+import 'package:tapture/core/widgets/app_list_tile.dart';
+import 'package:tapture/core/widgets/fields/app_multi_choice_field.dart';
+import 'package:tapture/core/widgets/fields/choice.dart';
+
+import '../../support/a11y_matchers.dart';
+import '../../support/screen_probe.dart';
+
+void main() {
+  for (final String mode in <String>['light', 'dark', 'outdoor']) {
+    for (final TextDirection direction in TextDirection.values) {
+      testWidgets('compact padding preserves targets in $mode $direction', (
+        WidgetTester tester,
+      ) async {
+        int opened = 0;
+        int edited = 0;
+        await _pump(
+          tester,
+          mode: mode,
+          direction: direction,
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: <Widget>[
+              for (final AppButtonVariant variant in AppButtonVariant.values)
+                AppButton(
+                  label: variant.name,
+                  variant: variant,
+                  onPressed: () {},
+                ),
+              const AppCard(child: Text('Card content')),
+              AppListTile(
+                title: 'Record',
+                subtitle: 'Captured today',
+                leading: const Icon(Icons.image),
+                onTap: () => opened++,
+                trailing: AppIconButton(
+                  icon: Icons.edit,
+                  semanticLabel: 'Edit',
+                  tooltip: 'Edit',
+                  onPressed: () => edited++,
+                ),
+              ),
+              AppMultiChoiceField<String>(
+                label: 'Options',
+                options: const <Choice<String>>[Choice<String>('a', 'Alpha')],
+                value: const <String>{'a'},
+                onChanged: (_) {},
+              ),
+            ],
+          ),
+        );
+
+        for (final Element button in find.byType(AppButton).evaluate()) {
+          expect(tester.getSize(find.byWidget(button.widget)).height, 48);
+        }
+        final double cardContent = tester
+            .getSize(find.text('Card content'))
+            .height;
+        expect(tester.getSize(find.byType(AppCard)).height, cardContent + 16);
+        expect(tester.getSize(find.byType(AppListTile)).height, 50);
+        expect(find.byType(AppListTile), meetsTapTarget());
+        expect(find.byType(AppIconButton), meetsTapTarget());
+        final Finder multi = find.byType(AppMultiChoiceField<String>);
+        expect(multi, meetsTapTarget());
+        expect(tester.getSize(multi).height, lessThanOrEqualTo(64));
+
+        await tester.tap(find.text('Record'));
+        expect(opened, 1);
+        await tester.tap(find.byType(AppIconButton));
+        expect(edited, 1);
+        expect(opened, 1);
+        await expectNoA11yIssues(tester);
+      });
+
+      testWidgets('tight padding grows for wrapped text in $mode $direction', (
+        WidgetTester tester,
+      ) async {
+        await _pump(
+          tester,
+          mode: mode,
+          direction: direction,
+          scale: 2,
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: <Widget>[
+              AppButton(
+                label: 'Save the complete captured project record',
+                expand: true,
+                onPressed: () {},
+              ),
+              AppCard(
+                onTap: () {},
+                child: const Text(
+                  'Read every word of this longer card description.',
+                ),
+              ),
+              AppListTile(
+                title: 'Read every word of this longer captured record title',
+                subtitle: 'Its complete supporting description stays readable.',
+                wrapText: true,
+                onTap: () {},
+              ),
+            ],
+          ),
+        );
+
+        expect(tester.takeException(), isNull);
+        expect(ScreenProbe.layoutIssues(tester), isEmpty);
+        expect(tester.getSize(find.byType(AppButton)).height, greaterThan(48));
+        expect(
+          tester.getSize(find.byType(AppListTile)).height,
+          greaterThan(50),
+        );
+        await expectNoA11yIssues(tester);
+      });
+    }
+  }
+}
+
+Future<void> _pump(
+  WidgetTester tester, {
+  required String mode,
+  required TextDirection direction,
+  required Widget child,
+  double scale = 1,
+}) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = const Size(320, 900);
+  addTearDown(() {
+    tester.view.resetPhysicalSize();
+    tester.view.resetDevicePixelRatio();
+  });
+  await tester.pumpWidget(
+    MaterialApp(
+      theme: buildTheme(
+        brightness: mode == 'dark' ? Brightness.dark : Brightness.light,
+        outdoor: mode == 'outdoor',
+      ),
+      builder: (BuildContext context, Widget? nested) => MediaQuery(
+        data: MediaQuery.of(
+          context,
+        ).copyWith(textScaler: TextScaler.linear(scale)),
+        child: Directionality(textDirection: direction, child: nested!),
+      ),
+      home: Scaffold(
+        body: SingleChildScrollView(
+          padding: const EdgeInsets.all(Space.x3),
+          child: child,
+        ),
+      ),
+    ),
+  );
+}
diff --git a/frontend/test/core/widgets/app_list_tile_test.dart b/frontend/test/core/widgets/app_list_tile_test.dart
new file mode 100644
--- /dev/null
+++ b/frontend/test/core/widgets/app_list_tile_test.dart
@@ -0,0 +1,279 @@
+import 'dart:ui' show Tristate;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/semantics.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tapture/app/theme/app_theme.dart';
+import 'package:tapture/app/theme/dimensions.dart';
+import 'package:tapture/core/widgets/app_icon_button.dart';
+import 'package:tapture/core/widgets/app_list_tile.dart';
+import 'package:tapture/core/widgets/app_page.dart';
+import 'package:tapture/core/widgets/app_status_pill.dart';
+
+import '../../support/a11y_matchers.dart';
+import '../../support/screen_probe.dart';
+
+void main() {
+  testWidgets('a wrapped pane row retains its whole title and count at 2x', (
+    WidgetTester tester,
+  ) async {
+    tester.platformDispatcher.textScaleFactorTestValue = 2;
+    addTearDown(tester.platformDispatcher.clearTextScaleFactorTestValue);
+    await _pump(
+      tester,
+      const SizedBox(
+        width: 220,
+        child: AppListTile(
+          title: 'Test project',
+          subtitle: 'No records',
+          wrapText: true,
+        ),
+      ),
+    );
+    expect(ScreenProbe.layoutIssues(tester), isEmpty);
+    expect(find.text('Test project'), findsOneWidget);
+    expect(find.text('No records'), findsOneWidget);
+  });
+
+  testWidgets('tap opens and long-press selects', (WidgetTester tester) async {
+    bool opened = false;
+    bool selected = false;
+    await _pump(
+      tester,
+      AppListTile(
+        title: 'Boiler A',
+        subtitle: 'Plant 3',
+        onTap: () => opened = true,
+        onLongPress: () => selected = true,
+      ),
+    );
+
+    expect(find.byType(AppListTile), meetsTapTarget());
+    expect(find.byType(AppListTile), hasSemanticLabel('Boiler A'));
+
+    await tester.tap(find.byType(AppListTile));
+    await tester.pump();
+    expect(opened, isTrue);
+    expect(selected, isFalse);
+
+    await tester.longPress(find.byType(AppListTile));
+    await tester.pump();
+    expect(selected, isTrue);
+  });
+
+  testWidgets('one row action preserves a separate trailing action and slots', (
+    WidgetTester tester,
+  ) async {
+    final SemanticsHandle semantics = tester.ensureSemantics();
+    int opened = 0;
+    int selected = 0;
+    int restored = 0;
+    await _pump(
+      tester,
+      AppListTile(
+        title: 'Boiler A',
+        subtitle: 'Plant 3',
+        selected: true,
+        leading: Semantics(
+          container: true,
+          label: 'Source photograph',
+          child: const Icon(Icons.image),
+        ),
+        status: const AppStatusPill.badge(status: RecordStatus.draft),
+        onTap: () => opened++,
+        onLongPress: () => selected++,
+        trailing: AppIconButton(
+          icon: Icons.restore,
+          semanticLabel: 'Restore record',
+          tooltip: 'Restore record',
+          onPressed: () => restored++,
+        ),
+      ),
+    );
+    final SemanticsNode row = tester.getSemantics(find.byType(AppListTile));
+    final List<SemanticsNode> nodes = <SemanticsNode>[];
+    void collect(SemanticsNode node) {
+      nodes.add(node);
+      node.visitChildren((SemanticsNode child) {
+        collect(child);
+        return true;
+      });
+    }
+
+    collect(row);
+    final List<SemanticsNode> taps = nodes.where((SemanticsNode node) {
+      return node.getSemanticsData().hasAction(SemanticsAction.tap);
+    }).toList();
+    expect(taps, hasLength(2));
+    final SemanticsNode primary = taps.singleWhere((SemanticsNode node) {
+      return node.getSemanticsData().label.contains('Boiler A');
+    });
+    final SemanticsNode trailing = taps.singleWhere((SemanticsNode node) {
+      return node.getSemanticsData().label == 'Restore record';
+    });
+    final String labels = nodes
+        .map((SemanticsNode node) => node.getSemanticsData().label)
+        .join('\n');
+    expect('Boiler A'.allMatches(labels), hasLength(1));
+    expect(labels, isNot(contains('Plant 3')));
+    expect(primary.getSemanticsData().hint, 'Plant 3');
+    expect(
+      primary.getSemanticsData().flagsCollection.isSelected,
+      Tristate.isTrue,
+    );
+    expect(labels, contains('Source photograph'));
+    expect(labels, contains('Draft'));
+
+    final SemanticsOwner owner = primary.owner!;
+    owner.performAction(primary.id, SemanticsAction.tap);
+    expect(opened, 1);
+    expect(restored, 0);
+    owner.performAction(primary.id, SemanticsAction.longPress);
+    expect(selected, 1);
+    owner.performAction(trailing.id, SemanticsAction.tap);
+    expect(restored, 1);
+    expect(opened, 1);
+    // Handles are checked before tear-downs run, so release it here.
+    semantics.dispose();
+  });
+
+  testWidgets('selection and status are named, not colour alone', (
+    WidgetTester tester,
+  ) async {
+    await _pump(
+      tester,
+      const AppListTile(
+        title: 'Boiler A',
+        selected: true,
+        status: AppStatusPill.badge(status: RecordStatus.draft),
+      ),
+    );
+
+    expect(find.byIcon(Icons.check), findsOneWidget);
+    expect(find.text('Draft'), findsOneWidget);
+    expect(find.byIcon(Icons.edit_note), findsOneWidget);
+  });
+
+  testWidgets('the current row is marked by a start bar and announced', (
+    WidgetTester tester,
+  ) async {
+    final SemanticsHandle semantics = tester.ensureSemantics();
+    await _pump(
+      tester,
+      Column(
+        children: <Widget>[
+          AppListTile(title: 'Open', current: true, onTap: () {}),
+          AppListTile(title: 'Other', onTap: () {}),
+        ],
+      ),
+    );
+
+    final Finder mark = find.byKey(AppListTile.currentMarkKey);
+    expect(mark, findsOneWidget);
+    final DecoratedBox bar = tester.widget<DecoratedBox>(mark);
+    expect(bar.position, DecorationPosition.foreground);
+    // A start-edge border follows the reading direction, so the bar sits
+    // on the right under a right-to-left locale (FE-L10N-05).
+    final BorderDirectional border =
+        (bar.decoration as BoxDecoration).border! as BorderDirectional;
+    expect(border.start.width, Space.x1);
+    expect(border.end, BorderSide.none);
+    expect(
+      tester.getSemantics(find.byType(AppListTile).first),
+      matchesSemantics(
+        label: 'Open',
+        isSelected: true,
+        hasSelectedState: true,
+        isButton: true,
+        hasEnabledState: true,
+        isEnabled: true,
+        isFocusable: true,
+        hasFocusAction: true,
+        hasTapAction: true,
+      ),
+    );
+    expect(find.byIcon(Icons.check), findsNothing);
+    semantics.dispose();
+  });
+
+  testWidgets('a current row can also be ticked for multi-select', (
+    WidgetTester tester,
+  ) async {
+    await _pump(
+      tester,
+      const AppListTile(title: 'Open', current: true, selected: true),
+    );
+    expect(find.byKey(AppListTile.currentMarkKey), findsOneWidget);
+    expect(find.byIcon(Icons.check), findsOneWidget);
+  });
+
+  testWidgets('a dense row stays usable at 200 percent text scale', (
+    WidgetTester tester,
+  ) async {
+    tester.platformDispatcher.textScaleFactorTestValue = 2;
+    addTearDown(tester.platformDispatcher.clearTextScaleFactorTestValue);
+    await tester.pumpWidget(
+      MaterialApp(
+        theme: buildTheme(brightness: Brightness.light),
+        home: AppPage(
+          title: 'Row',
+          body: AppListTile(
+            dense: true,
+            title: 'A very long record title that must wrap rather than clip',
+            subtitle: 'Plant 3 · captured this morning',
+            onTap: () {},
+            onLongPress: () {},
+          ),
+        ),
+      ),
+    );
+    expect(tester.takeException(), isNull);
+    await expectNoA11yIssues(tester);
+  });
+
+  testWidgets(
+    'a long status leaves room for the restore action at 200 percent',
+    (WidgetTester tester) async {
+      bool restored = false;
+      await _pump(
+        tester,
+        AppListTile(
+          title: 'Long deleted record title',
+          leading: const Icon(Icons.image),
+          selected: true,
+          status: const AppStatusPill.badge(
+            status: RecordStatus.deleted,
+            label: '28 days remaining before permanent deletion',
+          ),
+          trailing: AppIconButton(
+            icon: Icons.restore,
+            semanticLabel: 'Restore record',
+            tooltip: 'Restore record',
+            onPressed: () => restored = true,
+          ),
+        ),
+      );
