@@ -0,0 +1,57 @@
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tapture/core/errors/result.dart';
+import 'package:tapture/core/files/blob_store.dart';
+
+void main() {
+  test('tree removal is durable, bounded and retryable', () async {
+    final Map<String, Uint8List> backing = <String, Uint8List>{};
+    final BlobStore store = BlobStore.memory(backing: backing);
+    for (final String key in <String>[
+      'projects/p1',
+      'projects/p1/raw/photo.jpg',
+      'projects/p1/templates/source.xlsx',
+      'projects/p10/raw/keep.jpg',
+      'projects/p2/raw/keep.jpg',
+    ]) {
+      (await store.write(key, Uint8List.fromList(<int>[1]))).getOrThrow();
+    }
+    (await store.removeTree('projects/p1')).getOrThrow();
+    final BlobStore reopened = BlobStore.memory(backing: backing);
+    expect(
+      (await reopened.read('projects/p1/raw/photo.jpg')).getOrThrow(),
+      isNull,
+    );
+    expect(
+      (await reopened.read('projects/p1/templates/source.xlsx')).getOrThrow(),
+      isNull,
+    );
+    expect(
+      (await reopened.read('projects/p10/raw/keep.jpg')).getOrThrow(),
+      isNotNull,
+    );
+    expect(
+      (await reopened.read('projects/p2/raw/keep.jpg')).getOrThrow(),
+      isNotNull,
+    );
+    expect(await reopened.removeTree('projects/p1'), isA<Success<void>>());
+    expect(
+      await reopened.removeTree('../projects'),
+      isA<FailureResult<void>>(),
+    );
+    expect(await reopened.removeTree(''), isA<FailureResult<void>>());
+  });
+
+  test('failed tree deletion preserves the entire selection', () async {
+    final Map<String, Uint8List> backing = <String, Uint8List>{
+      'projects/p1/raw/photo.jpg': Uint8List.fromList(<int>[1]),
+    };
+    final BlobStore store = BlobStore.memory(
+      backing: backing,
+      failWrites: true,
+    );
+    expect(await store.removeTree('projects/p1'), isA<FailureResult<void>>());
+    expect(backing, hasLength(1));
+  });
+}
