+// Populate required unrelated payload columns from schema defaults; ownership,
+// identities, evidence and the values asserted above are supplied explicitly.
+Future<void> _seed(
+  AppDatabase db,
+  String table,
+  String id,
+  Map<String, Object?> values,
+) async {
+  final List<QueryRow> columns = await db
+      .customSelect('PRAGMA table_info($table)')
+      .get();
+  final Map<String, Object?> data = <String, Object?>{'id': id};
+  for (final QueryRow column in columns) {
+    final String name = column.read<String>('name');
+    if (column.read<int>('notnull') == 0 ||
+        column.data['dflt_value'] != null ||
+        name == 'id') {
+      continue;
+    }
+    final String type = column.read<String>('type');
+    data[name] = type.contains('INT') || type.contains('REAL') ? 0 : '';
+  }
+  data.addAll(values);
+  data.removeWhere(
+    (String name, Object? _) =>
+        !columns.any((QueryRow column) => column.read<String>('name') == name),
+  );
+  await db.customInsert(
+    'INSERT INTO $table (${data.keys.map((String key) => '"$key"').join(',')}) VALUES (${List<String>.filled(data.length, '?').join(',')})',
+    variables: data.values
+        .map((Object? value) => Variable<Object>(value))
+        .toList(),
+  );
+}
+
+Future<bool> _has(AppDatabase db, String table, String id) async =>
+    (await db
+            .customSelect(
+              'SELECT id FROM $table WHERE id = ?',
+              variables: <Variable<Object>>[Variable<String>(id)],
+            )
+            .get())
+        .isNotEmpty;
