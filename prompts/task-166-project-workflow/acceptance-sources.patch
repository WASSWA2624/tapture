+@TestOn('browser')
+library;
+
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tapture/core/files/blob_store.dart';
+import 'package:tapture/core/files/file_writer_web.dart';
+import 'package:tapture/core/files/project_tree_purge_web.dart';
+import 'package:tapture/core/files/storage_root.dart';
+
+void main() {
+  test(
+    'IndexedDB project and merge cascades preserve adjacent prefixes after reopening',
+    () async {
+      final String id = 'task166-${DateTime.now().microsecondsSinceEpoch}';
+      final BlobStore files = projectFileStore();
+      final String raw = 'projects/$id/raw/evidence.jpg';
+      final String template = 'projects/$id/templates/source.xlsx';
+      final String adjacent = 'projects/${id}0/keep';
+      final String retained =
+          '.recycle/merge-$id/projects/$id/raw/evidence.jpg';
+      for (final String path in <String>[raw, template, adjacent, retained]) {
+        (await files.write(path, Uint8List.fromList(<int>[1]))).getOrThrow();
+      }
+      addTearDown(() async {
+        (await files.removeTree('projects/$id')).getOrThrow();
+        (await files.removeTree('projects/${id}0')).getOrThrow();
+        (await files.removeTree('.recycle/merge-$id')).getOrThrow();
+      });
+      (await purgeProjectTree(StorageRoot(), id)).getOrThrow();
+      (await purgeMergeTree(StorageRoot(), id)).getOrThrow();
+      final BlobStore reopened = BlobStore.platform('project-files');
+      expect((await reopened.read(raw)).getOrThrow(), isNull);
+      expect((await reopened.read(template)).getOrThrow(), isNull);
+      expect((await reopened.read(retained)).getOrThrow(), isNull);
+      expect((await reopened.read(adjacent)).getOrThrow(), isNotNull);
+    },
+  );
+}
