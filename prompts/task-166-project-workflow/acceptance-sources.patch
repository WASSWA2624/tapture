+import '../support/factories.dart';
+
+void main() {
+  test(
+    'only Projects and More own shell destinations, including capture and record routes',
+    () {
+      expect(
+        shellDestinations.map(
+          (ShellDestination destination) => destination.path,
+        ),
+        <String>['/projects', '/more'],
+      );
+      for (final String path in <String>[
+        '/projects/p1',
+        '/projects/p1/capture',
+        '/projects/p1/records/r1/values',
+      ]) {
+        expect(shellDestinationFor(Uri.parse(path))!.path, '/projects');
+      }
+      expect(shellDestinationFor(Uri.parse('/capture')), isNull);
+      expect(shellDestinationFor(Uri.parse('/records')), isNull);
+    },
+  );
+
+  for (final double width in <double>[393, 800, 1200]) {
+    for (final double scale in <double>[1, 2]) {
+      testWidgets(
+        'two navigation controls and project Capture at $width/$scale',
+        (WidgetTester tester) async {
+          tester.view.devicePixelRatio = 1;
+          tester.view.physicalSize = Size(width, 850);
+          tester.platformDispatcher.textScaleFactorTestValue = scale;
+          addTearDown(() {
+            tester.view.resetPhysicalSize();
+            tester.view.resetDevicePixelRatio();
+            tester.platformDispatcher.clearTextScaleFactorTestValue();
+          });
+          final _Fixture fixture = await _pump(tester);
+          await _go(tester, fixture.router, '/projects/p1/capture');
+          final Finder navigation = find.byKey(
+            ValueKey<String>(width < 600 ? 'nav-bar' : 'nav-rail'),
+          );
+          expect(navigation, findsOneWidget);
+          if (width < 600) {
+            expect(
+              tester
+                  .widget<NavigationBar>(find.byType(NavigationBar))
+                  .destinations,
+              hasLength(2),
+            );
+          } else {
+            expect(
+              tester
+                  .widget<NavigationRail>(find.byType(NavigationRail))
+                  .destinations,
+              hasLength(2),
+            );
+          }
+          expect(
+            fixture.router.state.uri.path,
+            '/projects/p1/capture',
+            reason:
+                '${fixture.router.state.error} params=${fixture.router.state.pathParameters}',
+          );
+          expect(fixture.container.read(currentProjectProvider), 'p1');
+          expect(find.byType(CaptureScreen), findsOneWidget);
+          expect(find.byKey(const ValueKey<String>('nav-pane')), findsNothing);
+          final AppOverflowMenu menu = tester.widget<AppOverflowMenu>(
+            find.byType(AppOverflowMenu).first,
+          );
+          expect(
+            menu.items.any(
+              (AppOverflowAction action) =>
+                  action.key ==
+                  const ValueKey<String>('capture-change-project'),
+            ),
+            isFalse,
+          );
+          expect(tester.takeException(), isNull);
+          await expectNoA11yIssues(tester);
+        },
+      );
+    }
+  }
+
+  testWidgets(
+    'legacy capture/record URLs resolve inside their owner, never exposing another project record',
+    (WidgetTester tester) async {
+      final _Fixture fixture = await _pump(tester);
+      fixture.container.read(currentProjectProvider.notifier).open('p1');
+      await _go(tester, fixture.router, '/capture');
+      expect(fixture.router.state.uri.path, '/projects/p1/capture');
+      await _go(tester, fixture.router, '/records?filter=needsReview');
+      expect(
+        fixture.router.state.uri.toString(),
+        '/projects/p1/records?filter=needsReview',
+      );
+      await _go(tester, fixture.router, '/records/r2');
+      expect(fixture.router.state.uri.path, '/projects/p2/records/r2');
+      expect(fixture.container.read(currentProjectProvider), 'p2');
+      expect(
+        tester
+            .widget<RecordDetailScreen>(find.byType(RecordDetailScreen))
+            .projectId,
+        'p2',
+      );
+      await _go(tester, fixture.router, '/projects/p1/records/r2/values');
+      expect(fixture.router.state.uri.path, '/projects/p1/records');
+      expect(find.byType(RecordDetailScreen), findsNothing);
+      expect(
+        tester
+            .widget<RecordsListScreen>(find.byType(RecordsListScreen))
+            .projectId,
+        'p1',
+      );
+      expect(tester.takeException(), isNull);
+    },
+  );
+
+  testWidgets('no opened project sends legacy entry points to Projects', (
+    WidgetTester tester,
+  ) async {
+    final _Fixture fixture = await _pump(tester);
+    for (final String path in <String>[
+      '/capture',
+      '/records',
+      '/records/missing',
+    ]) {
+      await _go(tester, fixture.router, path);
+      expect(fixture.router.state.uri.path, '/projects');
+    }
+  });
+
+  testWidgets(
+    'Back from capture returns through the project home to Projects',
+    (WidgetTester tester) async {
+      final _Fixture fixture = await _pump(tester);
+      await _go(tester, fixture.router, '/projects/p1/capture');
+      await ShellBackNavigation.back(
+        tester.element(find.byType(CaptureScreen)),
+      );
+      await tester.pumpAndSettle();
+      expect(fixture.router.state.uri.path, '/projects/p1');
+      await ShellBackNavigation.back(
+        tester.element(find.byKey(const ValueKey<String>('route-project'))),
+      );
+      await tester.pumpAndSettle();
+      expect(fixture.router.state.uri.path, '/projects');
+    },
+  );
+
+  testWidgets(
+    'restart resumes the previous project record, capture, list or settings screen',
+    (WidgetTester tester) async {
+      final SettingsStore store = SettingsStore.fake();
+      for (final String path in <String>[
+        '/projects/p2/records/r2',
+        '/projects/p1/capture',
+        '/projects/p2/records?filter=needsReview',
+        '/more/appearance',
+        '/projects',
+      ]) {
+        final _Fixture first = await _pump(tester, store: store);
+        await _go(tester, first.router, path);
+        await first.container
+            .read(lifecycleObserverProvider)
+            .handle(AppLifecycleState.paused);
+        expect(store.read(SettingKeys.lastLocation), path);
+        await tester.pumpWidget(const SizedBox.shrink());
+        final _Fixture restarted = await _pump(tester, store: store);
+        expect(restarted.router.state.uri.toString(), path);
+        expect(tester.takeException(), isNull);
+        await tester.pumpWidget(const SizedBox.shrink());
+      }
+    },
+  );
+
+  testWidgets(
+    'stale/deleted project and mismatched record routes fall back safely',
+    (WidgetTester tester) async {
+      for (final String path in <String>[
+        '/projects/missing/capture',
+        '/projects/deleted/records/r1',
+        '/projects/p1/records/missing',
+      ]) {
+        final _Fixture fixture = await _pump(
+          tester,
+          store: SettingsStore.fake(
+            stored: <String, Object?>{
