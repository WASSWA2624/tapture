+typedef _Fixture = ({
+  FakeProjectRepository projects,
+  FakeRecordRepository records,
+  List<DeletedEntity> calls,
+});
+Future<_Fixture> _pump(
+  WidgetTester tester, {
+  double width = 393,
+  double scale = 1,
+  RecyclePurge? purge,
+}) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = Size(width, 850);
+  tester.platformDispatcher.textScaleFactorTestValue = scale;
+  addTearDown(() {
+    tester.view.resetPhysicalSize();
+    tester.view.resetDevicePixelRatio();
+    tester.platformDispatcher.clearTextScaleFactorTestValue();
+  });
+  final FakeProjectRepository projects = FakeProjectRepository();
+  (await projects.create(aProject(id: 'p1', name: 'First'))).getOrThrow();
+  (await projects.delete('p1')).getOrThrow();
+  final FakeRecordRepository records = FakeRecordRepository();
+  records.seedEntry(aRecordEntry(id: 'r2', projectId: 'p2', name: 'Second'));
+  (await records.delete('r2', reason: 'Deleted')).getOrThrow();
+  addTearDown(projects.dispose);
+  addTearDown(records.dispose);
+  final List<DeletedEntity> calls = <DeletedEntity>[];
+  await tester.pumpWidget(
+    ProviderScope(
+      key: UniqueKey(),
+      overrides: [
+        projectRepositoryProvider.overrideWithValue(projects),
+        recordRepositoryProvider.overrideWithValue(records),
+        recyclePurgeProvider.overrideWithValue((DeletedEntity entity) async {
+          calls.add(entity);
+          return purge == null ? const Success<void>(null) : purge(entity);
+        }),
+      ],
+      child: MaterialApp(
+        theme: buildTheme(brightness: Brightness.light),
+        localizationsDelegates: AppLocalizations.localizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        home: const RecycleBinScreen(),
+      ),
+    ),
+  );
+  await tester.pumpAndSettle();
+  return (projects: projects, records: records, calls: calls);
+}
