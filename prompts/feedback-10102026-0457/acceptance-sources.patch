+final class _AuditedRecorder implements AudioRecorderService {
+  _AuditedRecorder(this.beforeAccess);
+
+  final Future<void> Function(String) beforeAccess;
+  final AudioRecorderService _inner = AudioRecorderService.fake();
+  int starts = 0;
+
+  @override
+  Stream<AudioRecorderState> get state => _inner.state;
+
+  @override
+  AudioRecording? get completed => _inner.completed;
+
+  @override
+  Future<Result<void>> start(String relativePath) async {
+    await beforeAccess(relativePath);
+    starts++;
+    return _inner.start(relativePath);
+  }
+
+  @override
+  Future<Result<void>> pause() => _inner.pause();
+
+  @override
+  Future<Result<void>> resume() => _inner.resume();
+
+  @override
+  Future<Result<Duration>> stop() => _inner.stop();
+}
