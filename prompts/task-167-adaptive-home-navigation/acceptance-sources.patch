+        '/projects/p1',
+        '/projects/p1/capture',
+        '/projects/p1/records/r1/values',
+      ]) {
+        expect(shellDestinationFor(Uri.parse(path))!.path, '/projects');
+      }
+      expect(shellDestinationFor(Uri.parse('/capture')), isNull);
+      expect(shellDestinationFor(Uri.parse('/records')), isNull);
+    },
