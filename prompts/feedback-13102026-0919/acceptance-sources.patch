+    expect(capture.session.photos, hasLength(1));
+  });
+}
+
+const int _mib = 1024 * 1024;
+const int _ample = 800 * _mib;
+const int _low = 300 * _mib;
+const int _critical = 50 * _mib;
+
+final Uint8List _bytes = pickedPhotoBytes();
+
+/// A capture page whose storage guard reads a free-space figure the test
+/// moves, and whose lifecycle the test drives.
+final class _Guarded {
+  _Guarded._(this._tester, this.photos, this.sessions, this.router);
+
+  final WidgetTester _tester;
+
+  /// Photo rows and bytes.
+  final FakeCapturePhotoRepository photos;
+
+  /// The session store, whose photo writes can be held.
+  final _Held sessions;
+
+  /// The router, to see where Export went.
+  final GoRouter router;
+
+  final StreamController<AppLifecycleState> _lifecycle =
+      StreamController<AppLifecycleState>.broadcast();
+
+  /// Free bytes the guard reads on its next poll.
+  int free = 0;
+
+  static Future<_Guarded> open(WidgetTester tester, {required int free}) async {
+    final Directory documents = Directory.systemTemp.createTempSync(
+      'tapture-capture-guard-',
+    );
+    addTearDown(() async {
+      await tester.pumpWidget(const SizedBox.shrink());
+      await tester.runAsync(() async {
+        // Finish thumbnail reads before removing files on Windows.
+        await Future<void>.delayed(Duration.zero);
+        await documents.delete(recursive: true);
+      });
+    });
+    final StorageRoot storage = StorageRoot.fake(documentsDirectory: documents);
+    // Resolved once for real; later polls read the memo, not the disk.
+    await tester.runAsync(storage.resolve);
+    final FakeCapturePhotoRepository photos = FakeCapturePhotoRepository(
+      thumbs: documents,
+    );
+    final _Held sessions = _Held(
+      CapturePersistenceImpl(photos: photos, store: TextStore.memory()),
+    );
+    final GoRouter router = GoRouter(
+      initialLocation: RoutePaths.projectCapture('p1'),
+      routes: <RouteBase>[
+        GoRoute(
+          path: '/projects/:projectId/capture',
+          builder: (BuildContext _, GoRouterState state) => Scaffold(
+            body: CaptureScreen(projectId: state.pathParameters['projectId']!),
+          ),
+        ),
+        GoRoute(
+          path: '/projects/:projectId/exports',
+          builder: (BuildContext _, GoRouterState _) => const Text('exports'),
+        ),
+      ],
+    );
+    addTearDown(router.dispose);
+    final _Guarded guarded = _Guarded._(tester, photos, sessions, router)
+      ..free = free;
+    final StorageGuard guard = StorageGuard.fake(
+      storageRoot: storage,
+      freeBytes: () => guarded.free,
+      lifecycle: guarded._lifecycle.stream,
+    );
+    addTearDown(guard.dispose);
+    addTearDown(guarded._lifecycle.close);
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: <Override>[
+          fieldEditorBindingsProvider.overrideWithValue(
+            templateFieldEditorBindings,
+          ),
+          storageGuardProvider.overrideWithValue(guard),
+          captureProjectTemplatesProvider.overrideWith(
+            (Ref _, String _) => Stream<List<TemplateDef>>.value(<TemplateDef>[
+              aTemplate(id: 't1', projectId: 'p1'),
+            ]),
+          ),
+          currentProjectDetailsProvider.overrideWith(
+            (Ref _) => aProject(id: 'p1'),
+          ),
+          photoRepositoryProvider.overrideWith((Ref _) => photos),
+          capturePersistenceProvider.overrideWith((Ref _) => sessions),
+          photoPickerProvider.overrideWith(
+            (Ref _) => PhotoPicker.fake(photos: <Uint8List>[_bytes]),
+          ),
+        ],
+        child: MaterialApp.router(routerConfig: router),
+      ),
+    );
+    await tester.pumpAndSettle();
+    return guarded;
+  }
+
+  /// Capture's photo-source action remains available beside the caption.
+  Finder get addControl =>
+      find.byKey(const ValueKey<String>('capture-composer-add-photo'));
+
+  /// The live session of project `p1`.
+  CaptureSession get session => ProviderScope.containerOf(
+    _tester.element(find.byType(CaptureScreen)),
+  ).read(captureControllerProvider('p1'));
+
+  /// Adds one photo through the add sheet's library action.
+  Future<void> addPhoto() async {
+    final int before = session.photos.length;
+    await _tester.tap(addControl);
+    await _tester.pumpAndSettle();
+    await _tester.tap(find.text(Copy.captureChoosePhoto));
+    await pumpExternalWork(_tester, () => session.photos.length > before);
+  }
+
+  /// Brings the app back to the foreground, so the guard polls again.
+  Future<void> resume() async {
+    _lifecycle.add(AppLifecycleState.resumed);
+    await _tester.pumpAndSettle();
+  }
+}
+
+/// A session store whose photo writes can be held mid-flight.
+final class _Held implements CapturePersistence {
+  _Held(this._inner);
+
+  final CapturePersistence _inner;
+  Completer<void>? _gate;
+
+  /// Whether a photo write has entered the persistence boundary.
+  bool writing = false;
+
+  /// Holds every photo write until [releasePhotos].
+  void holdPhotos() => _gate = Completer<void>();
+
+  /// Lets held photo writes finish.
+  void releasePhotos() => _gate?.complete();
+
+  @override
+  PhotoRepository get photos => _inner.photos;
+
+  @override
+  Future<Result<PhotoDraft>> savePhoto(
+    PhotoDraft photo, {
+    Uint8List? bytes,
+  }) async {
+    writing = true;
+    await _gate?.future;
+    return _inner.savePhoto(photo, bytes: bytes);
+  }
+
+  @override
+  Future<Result<void>> deletePhoto(String photoId, {required String reason}) =>
+      _inner.deletePhoto(photoId, reason: reason);
+
+  @override
+  Future<Result<void>> saveSession(CaptureSession session) =>
+      _inner.saveSession(session);
+
+  @override
+  Future<Result<CaptureSession?>> loadSession(String key) =>
+      _inner.loadSession(key);
+
+  @override
+  Future<Result<void>> clearSession(String key) => _inner.clearSession(key);
+}
