+
+void main() {
+  setUpAll(ScreenFonts.load);
+  final List<Choice<String>> options = <Choice<String>>[
+    const Choice<String>('a', 'Alpha'),
+    const Choice<String>('b', 'Bravo'),
+    const Choice<String>('c', 'Charlie'),
+  ];
+
+  testWidgets('closed field shows selected values as chips', (
+    WidgetTester tester,
+  ) async {
+    await _pump(
+      tester,
+      AppMultiChoiceField<String>(
+        label: 'Tags',
+        options: options,
+        value: const <String>{'a', 'c'},
+        onChanged: (_) {},
+      ),
+    );
+
+    expect(find.text('Alpha'), findsOneWidget);
+    expect(find.text('Charlie'), findsOneWidget);
+    expect(find.text('Bravo'), findsNothing);
+    expect(find.byType(AppChip), findsNWidgets(2));
+    expect(find.byType(AppMultiChoiceField<String>), meetsTapTarget());
+    expect(find.byType(AppMultiChoiceField<String>), hasSemanticLabel('Tags'));
+  });
+
+  testWidgets('select-all and clear update the selection', (
+    WidgetTester tester,
+  ) async {
+    Set<String> latest = const <String>{};
+    await _pump(
+      tester,
+      AppMultiChoiceField<String>(
+        label: 'Tags',
+        options: options,
+        value: latest,
+        onChanged: (Set<String> value) => latest = value,
+      ),
+      size: const Size(400, 800),
+    );
+
+    await tester.tap(find.byType(AppMultiChoiceField<String>));
+    await tester.pumpAndSettle();
+
+    await tester.tap(find.text('Select all'));
+    await tester.pump();
+    expect(latest, <String>{'a', 'b', 'c'});
+
+    await tester.tap(find.text('Clear'));
+    await tester.pump();
+    expect(latest, isEmpty);
+  });
+
+  testWidgets('a 200-option list can be searched on a compact screen', (
+    WidgetTester tester,
+  ) async {
+    final List<Choice<int>> many = <Choice<int>>[
+      for (int i = 0; i < 200; i++) Choice<int>(i, 'Option $i'),
+    ];
+    Set<int> latest = const <int>{};
+    await _pump(
+      tester,
+      AppMultiChoiceField<int>(
+        label: 'Items',
+        options: many,
+        value: latest,
+        onChanged: (Set<int> value) => latest = value,
+      ),
+      size: const Size(400, 800),
+    );
+
+    await tester.tap(find.byType(AppMultiChoiceField<int>));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byType(TextField), '199');
+    await tester.pump();
+    expect(find.text('Option 199'), findsOneWidget);
+    expect(find.text('Option 0'), findsNothing);
+
+    await tester.tap(find.text('Option 199'));
+    await tester.pump();
+    expect(latest, <int>{199});
+    expect(find.byIcon(Icons.check), findsWidgets);
+  });
+
+  for (final ScreenMatrix cell in ScreenMatrix.cells) {
+    for (final TargetPlatform platform in _platforms) {
+      testWidgets('filled selection commands retain equal targets at '
+          '${cell.description} ${platform.name}', (WidgetTester tester) async {
+        await _verifyCommands(tester, options, cell, platform: platform);
+      });
+    }
+  }
+
+  for (final String theme in <String>['light', 'dark', 'outdoor']) {
+    for (final TextDirection direction in TextDirection.values) {
+      for (final TargetPlatform platform in _platforms) {
+        testWidgets('expanded copy and $direction commands stay reachable in '
+            '$theme short landscape with keyboard ${platform.name}', (
+          WidgetTester tester,
+        ) async {
+          await _verifyCommands(
+            tester,
+            options,
+            ScreenMatrix(
+              const Size(393, 320),
+              2,
+              theme == 'dark' ? Brightness.dark : Brightness.light,
+              theme == 'outdoor',
+            ),
+            locale: const Locale('en', 'XA'),
+            direction: direction,
+            keyboard: 112,
+            platform: platform,
+          );
+        });
+      }
+    }
+  }
+
+  testWidgets('an empty option set disables both filled commands', (
+    WidgetTester tester,
+  ) async {
+    int changes = 0;
+    await _pump(
+      tester,
+      AppMultiChoiceField<String>(
+        label: 'Tags',
+        options: const <Choice<String>>[],
+        value: const <String>{},
+        onChanged: (_) => changes++,
+      ),
+    );
+    await _open(tester);
+    await _verifyGeometry(tester);
+    for (final FilledButton button in tester.widgetList<FilledButton>(
+      find.byType(FilledButton),
+    )) {
+      expect(button.onPressed, isNull);
+    }
+    expect(changes, 0);
+  });
+
+  testWidgets(
+    'keyboard traversal reaches Select all before Clear and activates '
+    'both',
+    (WidgetTester tester) async {
+      Set<String> selected = <String>{'c'};
+      await _pump(
+        tester,
+        AppMultiChoiceField<String>(
+          label: 'Tags',
+          options: options,
+          value: selected,
+          onChanged: (Set<String> next) => selected = next,
+        ),
+      );
+      await _open(tester);
+      await tester.tap(find.byType(TextField));
+      final Finder select = _action(tester, selectAll: true);
+      final Finder clear = _action(tester, selectAll: false);
+      for (
+        int attempt = 0;
+        attempt < 12 && !_focusedWithin(select);
+        attempt++
+      ) {
+        await tester.sendKeyEvent(LogicalKeyboardKey.tab);
+        await tester.pump();
+        expect(_focusedWithin(clear), isFalse);
+      }
+      expect(_focusedWithin(select), isTrue);
+      await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+      await tester.pump();
+      expect(selected, <String>{'a', 'b', 'c'});
+      await tester.sendKeyEvent(LogicalKeyboardKey.tab);
+      await tester.pump();
+      expect(_focusedWithin(clear), isTrue);
+      await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+      await tester.pump();
+      expect(selected, isEmpty);
+      await _verifyGeometry(tester);
+    },
+  );
+
+  for (final ({String name, ScreenMatrix cell}) corner
+      in ScreenMatrix.corners) {
+    testWidgets('filled multi-choice sheet golden ${corner.name}', (
+      WidgetTester tester,
+    ) async {
+      await _pump(
+        tester,
+        AppMultiChoiceField<String>(
+          label: 'Status',
+          options: options,
+          value: const <String>{'c'},
+          onChanged: (_) {},
+        ),
+        cell: corner.cell,
+      );
+      await _open(tester);
+      await _verifyGeometry(tester);
+      await expectLater(
+        find.byType(MaterialApp),
+        matchesGoldenFile(
+          'goldens/feedback_13102026_multichoice_${corner.name}.png',
+        ),
+      );
+    });
+  }
+}
+
+Future<void> _verifyCommands(
+  WidgetTester tester,
+  List<Choice<String>> options,
+  ScreenMatrix cell, {
+  Locale locale = const Locale('en'),
+  TextDirection direction = TextDirection.ltr,
+  double keyboard = 0,
+  TargetPlatform platform = TargetPlatform.android,
+}) async {
+  final Set<String> original = <String>{'c'};
+  final List<Set<String>> changes = <Set<String>>[];
+  await _pump(
+    tester,
+    AppMultiChoiceField<String>(
+      label: 'Tags',
+      options: options,
+      value: original,
+      onChanged: changes.add,
+    ),
+    cell: cell,
+    locale: locale,
+    direction: direction,
+    platform: platform,
+  );
+  await _open(tester);
+  tester.view.viewInsets = FakeViewPadding(bottom: keyboard);
+  addTearDown(tester.view.resetViewInsets);
+  await tester.pumpAndSettle();
+  final Finder search = find.byType(TextField, skipOffstage: false);
+  await tester.ensureVisible(search);
+  await tester.enterText(search, 'alPha');
+  await tester.pumpAndSettle();
+  await _verifyGeometry(tester);
+  await tester.tap(_action(tester, selectAll: true));
+  await tester.pumpAndSettle();
+  expect(changes.single, <String>{'a', 'c'});
+  expect(original, <String>{'c'});
+  expect(() => changes.single.add('b'), throwsUnsupportedError);
+  await tester.tap(_action(tester, selectAll: false));
+  await tester.pumpAndSettle();
+  expect(changes.last, isEmpty);
+  expect(changes.first, <String>{'a', 'c'});
+  expect(
+    tester.widget<FilledButton>(_action(tester, selectAll: false)).onPressed,
+    isNull,
+  );
+  await tester.ensureVisible(search);
+  await tester.enterText(search, 'missing');
+  await tester.pumpAndSettle();
+  expect(
+    tester.widget<FilledButton>(_action(tester, selectAll: true)).onPressed,
+    isNull,
+  );
+  await _verifyGeometry(tester);
+}
+
+Future<void> _open(WidgetTester tester) async {
+  await tester.ensureVisible(find.byType(AppMultiChoiceField<String>));
+  await tester.tap(find.byType(AppMultiChoiceField<String>));
+  await tester.pumpAndSettle();
+}
+
+Finder _action(WidgetTester tester, {required bool selectAll}) {
+  final LocalizedCopy copy = Copy.of(
+    tester.element(find.byType(AppBottomSheet).last),
+  );
+  return find.widgetWithText(
+    FilledButton,
+    selectAll ? copy.selectAll : copy.clear,
+    skipOffstage: false,
+  );
+}
+
+bool _focusedWithin(Finder target) {
+  final BuildContext? focused = FocusManager.instance.primaryFocus?.context;
+  if (focused is! Element) return false;
+  final Element action = target.evaluate().single;
+  bool found = identical(action, focused);
+  focused.visitAncestorElements((Element ancestor) {
+    found = found || identical(ancestor, action);
+    return !found;
+  });
+  return found;
+}
+
+Future<void> _verifyGeometry(WidgetTester tester) async {
+  final Finder select = _action(tester, selectAll: true);
+  final Finder clear = _action(tester, selectAll: false);
+  await tester.ensureVisible(select);
+  await tester.pumpAndSettle();
+  final Rect first = tester.getRect(select);
+  final Rect second = tester.getRect(clear);
+  expect(first.width, closeTo(second.width, 1));
+  final double gap = first.left < second.left
+      ? second.left - first.right
+      : first.left - second.right;
+  expect(gap, closeTo(Space.x2, 0.01));
+  final LocalizedCopy copy = Copy.of(tester.element(select));
+  for (final (Finder, String) command in <(Finder, String)>[
+    (select, copy.selectAll),
+    (clear, copy.clear),
+  ]) {
+    expect(command.$1, meetsTapTarget());
+    expect(command.$1, hasSemanticLabel(command.$2));
+    final FilledButton button = tester.widget<FilledButton>(command.$1);
+    final ThemeData theme = Theme.of(tester.element(command.$1));
+    final Set<WidgetState> states = button.onPressed == null
+        ? <WidgetState>{WidgetState.disabled}
+        : <WidgetState>{};
+    final Color? fill =
+        button.style?.backgroundColor?.resolve(states) ??
+        theme.filledButtonTheme.style?.backgroundColor?.resolve(states);
+    final AppColors colors = tester.element(command.$1).colors;
+    expect(
+      fill,
+      button.onPressed == null ? colors.surfaceVariant : colors.primary,
+    );
+  }
+  expect(ScreenProbe.layoutIssues(tester), isEmpty);
+  expect(
+    await ScreenProbe.accessibilityIssues(
+      tester,
+      targets: <Finder>[select, clear],
+      within: find.byType(AppBottomSheet).last,
+    ),
+    isEmpty,
+  );
+}
+
+Future<void> _pump(
+  WidgetTester tester,
+  Widget child, {
+  Size size = const Size(400, 800),
+  ScreenMatrix? cell,
+  Locale locale = const Locale('en'),
+  TextDirection direction = TextDirection.ltr,
+  TargetPlatform platform = TargetPlatform.android,
+}) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = cell?.size ?? size;
+  addTearDown(() {
+    tester.view.resetPhysicalSize();
+    tester.view.resetDevicePixelRatio();
+  });
+  await tester.pumpWidget(
+    MaterialApp(
+      debugShowCheckedModeBanner: false,
+      locale: locale,
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      theme: ScreenFonts.theme(
+        buildTheme(
+          brightness: cell?.brightness ?? Brightness.light,
+          outdoor: cell?.outdoor ?? false,
+        ),
+      ).copyWith(platform: platform),
+      builder: (BuildContext context, Widget? nested) => MediaQuery(
+        data: MediaQuery.of(context).copyWith(
+          textScaler: TextScaler.linear(cell?.textScale ?? 1),
+          disableAnimations: true,
+        ),
+        child: Directionality(textDirection: direction, child: nested!),
+      ),
+      home: Scaffold(
+        body: SingleChildScrollView(
+          padding: const EdgeInsets.all(Space.x4),
+          child: child,
+        ),
+      ),
+    ),
+  );
+}
