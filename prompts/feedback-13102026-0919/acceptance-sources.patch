+import 'package:tapture/features/templates/templates.dart';
+
+import '../../../support/factories.dart';
+import '../../../support/fakes/fake_capture_photo_repository.dart';
+import '../../../support/pump_external_work.dart';
+import '../../../support/tracked_photo_file.dart';
+
+void main() {
+  testWidgets('with ample space capture shows nothing and adds a photo', (
+    WidgetTester tester,
+  ) async {
+    final _Guarded capture = await _Guarded.open(tester, free: _ample);
+
+    expect(find.byType(AppBanner), findsNothing);
+    expect(
+      find.byKey(const ValueKey<String>('capture-storage-full')),
+      findsNothing,
+    );
+    expect(
+      tester.getTopLeft(find.byType(PhotoTray)).dy,
+      tester.getBottomLeft(find.byType(CaptureStorageGuard)).dy,
+    );
+    await capture.addPhoto();
+
+    expect(capture.session.photos, hasLength(1));
+  });
+
+  testWidgets('low space warns once, dismissibly, and capture carries on', (
+    WidgetTester tester,
+  ) async {
+    final _Guarded capture = await _Guarded.open(tester, free: _low);
+    final Finder warning = find.byKey(
+      const ValueKey<String>('capture-storage-low'),
+    );
+
+    expect(warning, findsOneWidget);
+    expect(
+      find.text(Copy.captureStorageLow(Copy.fileSize(_low))),
+      findsOneWidget,
+    );
+    expect(
+      tester.getTopLeft(find.byType(PhotoTray)).dy -
+          tester.getBottomLeft(warning).dy,
+      Space.x4,
+    );
+    await capture.addPhoto();
+    expect(capture.session.photos, hasLength(1));
+
+    await tester.tap(find.byTooltip(Copy.dismiss));
+    await tester.pumpAndSettle();
+    expect(warning, findsNothing);
+    expect(
+      tester.getTopLeft(find.byType(PhotoTray)).dy,
+      tester.getBottomLeft(find.byType(CaptureStorageGuard)).dy,
+    );
+    // A later poll that is still low does not warn again this visit.
+    capture.free = _low - 1;
+    await capture.resume();
+    expect(warning, findsNothing);
+    await capture.addPhoto();
+    expect(capture.session.photos, hasLength(2));
+  });
+
+  testWidgets('at the stop threshold a new photo is refused, the free space '
+      'is named and Export opens the exports', (WidgetTester tester) async {
+    final _Guarded capture = await _Guarded.open(tester, free: _critical);
+
+    expect(
+      find.text(Copy.captureStorageFull(Copy.fileSize(_critical))),
+      findsOneWidget,
+    );
+    expect(
+      tester.getTopLeft(find.byType(PhotoTray)).dy -
+          tester
+              .getBottomLeft(
+                find.byKey(const ValueKey<String>('capture-storage-full')),
+              )
+              .dy,
+      Space.x4,
+    );
+    await tester.tap(capture.addControl);
+    await tester.pumpAndSettle();
+    // Refused before the add sheet opens.
+    expect(find.text(Copy.captureAddSheetTitle), findsNothing);
+    expect(
+      find.text('There is not enough free space to take another photo.'),
+      findsOneWidget,
+    );
+    expect(capture.session.photos, isEmpty);
+
+    await tester.tap(find.widgetWithText(AppButton, Copy.captureStorageExport));
+    await tester.pumpAndSettle();
+    expect(find.text('exports'), findsOneWidget);
+    expect(capture.router.state.uri.path, RoutePaths.projectExports('p1'));
+  });
+
+  testWidgets('a photo write under way when space runs out completes and '
+      'writes its row', (WidgetTester tester) async {
+    final _Guarded capture = await _Guarded.open(tester, free: _ample);
+    capture.sessions.holdPhotos();
+
+    await tester.tap(capture.addControl);
+    await tester.pumpAndSettle();
+    await tester.tap(find.text(Copy.captureChoosePhoto));
+    await pumpExternalWork(tester, () => capture.sessions.writing);
+    // The device fills while the photo is being written.
+    capture.free = _critical;
+    await capture.resume();
+    expect(
+      find.byKey(const ValueKey<String>('capture-storage-full')),
+      findsOneWidget,
+    );
