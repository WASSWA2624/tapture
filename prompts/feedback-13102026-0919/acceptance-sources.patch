+    capture.sessions.releasePhotos();
+    await pumpExternalWork(tester, () => capture.session.photos.length == 1);
+    expect(capture.session.photos, hasLength(1));
+    expect(capture.photos.drafts, hasLength(1));
+    expect(capture.photos.bytes.values.single, _bytes);
