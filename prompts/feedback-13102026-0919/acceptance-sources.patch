+  final Future<void> _release;
+
+  @override
+  Future<Result<void>> delete(String id, {required String reason}) async {
+    await _release;
+    return _inner.delete(id, reason: reason);
+  }
+
+  @override
+  Object? noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
