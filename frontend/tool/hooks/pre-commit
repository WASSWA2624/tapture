#!/bin/sh
#
# Refreshes the development tracker for every commit, including docs/backend.
# Runs the review gate on the staged paths.
# Installed by frontend/tool/install_hooks.dart (dev-plan tasks 001, 087, 099 and 100).
#
# frontend/.rules/13-workflow.md FE-FLOW-02: the gate is a command, and it runs
# locally before review exactly as it runs in continuous integration.

set -e

cd "$(git rev-parse --show-toplevel)"

# A task's staged checklist must be the checklist used to generate the tracker.
# Never stage or overwrite the user's selection of individual step-file or
# task-file hunks.
git diff --cached --name-only --diff-filter=ACMR -- \
	'dev-plan/[0-9][0-9]-*.md' 'dev-plan/[0-9][0-9]-*/[0-9][0-9]-*.md' |
while IFS= read -r task; do
	if ! git diff --quiet -- "$task"; then
		echo "dev tracker: $task is partially staged. Review and stage or restore its remaining changes before committing." >&2
		exit 1
	fi
done

cd frontend
if ! dart run tool/sync_dev_tracker.dart --check; then
	dart run tool/sync_dev_tracker.dart
	echo "dev tracker: refreshed dev-tracker.md. Review and stage it, then commit again. Nothing was auto-staged." >&2
	exit 1
fi
cd ..

# Compare the commit's own source checklists and summaries; unrelated unstaged
# prose can remain in the workspace without changing what the commit claims.
dart run frontend/tool/check_staged_dev_tracker.dart

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
	exit 0
fi

set --
while IFS= read -r path; do
	[ -n "$path" ] || continue
	case "$path" in
	frontend/*)
		set -- "$@" "${path#frontend/}"
		;;
	*)
		set -- "$@" "../$path"
		;;
	esac
done <<EOF
$staged
EOF

cd frontend
exec dart run tool/verify.dart --changed "$@"
