{
  "$comment": "Choice lists and per-field corrections for the catalogue generator. `option_sets` are the choice lists a pack or an inferred field names; each code becomes a `templates.choices.<set>.<code>` label. `overrides` replace what the generator infers for one catalogue field key: a list of one field renames or retypes it, a list of several splits it into atomic columns (§13.1). Edit here, then run `dart run tool/build_template_catalogue.dart`.",
  "option_sets": {
    "agreement_status": ["draft", "under_review", "signed", "active", "expired", "terminated"],
    "case_stage": ["received", "assessment", "in_progress", "referred", "resolved", "closed"],
    "check_result": ["pass", "pass_with_exceptions", "fail", "not_checked"],
    "communication_channel": ["email", "letter", "sms", "phone_call", "notice", "social_media", "press_release", "in_person"],
    "competency_result": ["competent", "not_yet_competent", "passed", "failed", "attended_only"],
    "condition": ["new", "good", "fair", "poor", "unserviceable"],
    "confirmation": ["confirmed", "pending", "not_confirmed"],
    "consent_status": ["given", "refused", "withdrawn", "not_asked"],
    "contact_channel": ["phone", "sms", "email", "in_person", "post", "other"],
    "decision": ["pending", "approved", "approved_with_conditions", "deferred", "rejected"],
    "entity_type": ["person", "household", "organisation", "business", "group", "other"],
    "entry_status": ["active", "inactive", "superseded", "archived"],
    "incident_status": ["open", "under_investigation", "action_pending", "closed", "reopened"],
    "inspection_result": ["pass", "pass_with_conditions", "fail", "not_inspected"],
    "interview_outcome": ["completed", "partial", "refused", "not_at_home", "other"],
    "plan_status": ["draft", "approved", "in_progress", "completed", "cancelled"],
    "priority": ["emergency", "high", "medium", "low"],
    "progress_stage": ["not_started", "in_progress", "blocked", "completed", "cancelled"],
    "proposal_status": ["drafting", "internal_review", "submitted", "awarded", "declined"],
    "quality_flag": ["valid", "estimated", "suspect", "rejected"],
    "rating": ["very_poor", "poor", "fair", "good", "excellent"],
    "risk_rating": ["low", "medium", "high", "critical"],
    "sample_condition": ["acceptable", "compromised", "rejected"],
    "sample_status": ["collected", "in_transit", "received", "tested", "disposed"],
    "severity": ["negligible", "minor", "moderate", "major", "critical"],
    "verification_status": ["unverified", "verified", "disputed", "not_applicable"]
  },
  "overrides": {
