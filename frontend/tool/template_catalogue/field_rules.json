    ],
    "activity_start": [
      {"key": "activity_start_at", "type": "date_time"}
    ],
    "adaptive_capacity": [
      {"key": "adaptive_capacity", "type": "long_text"}
    ],
    "address": [
      {"key": "street_address", "type": "text", "help": "House, plot and street only; the location fields hold the rest."}
    ],
    "agreed_rate": [
      {"key": "agreed_rate_amount", "type": "currency", "input_mode": "manual_only"},
      {"key": "agreed_rate_currency", "type": "text"},
      {"key": "agreed_rate_basis", "type": "text", "help": "Per hour, day, unit or item."}
    ],
    "amount_due": [
      {"key": "due_amount", "type": "currency", "input_mode": "manual_only"},
      {"key": "due_currency", "type": "text"}
