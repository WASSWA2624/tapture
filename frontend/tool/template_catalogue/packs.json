    "identity": ["agreement_reference"],
    "fields": [
      {"key": "agreement_reference", "type": "text", "required": "REQUIRED"},
      {"key": "agreement_title", "type": "text", "required": "REQUIRED"},
      {"key": "first_party_name", "type": "text", "required": "REQUIRED", "from": "parties"},
      {"key": "second_party_name", "type": "text", "required": "RECOMMENDED", "from": "parties"},
