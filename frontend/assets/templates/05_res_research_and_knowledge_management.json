            {
              "code": "refused",
              "label": "templates.choices.consent_status.refused"
            },
            {
              "code": "withdrawn",
              "label": "templates.choices.consent_status.withdrawn"
            },
            {
              "code": "not_asked",
              "label": "templates.choices.consent_status.not_asked"
            }
