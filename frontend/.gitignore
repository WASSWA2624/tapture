# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.dart_tool/chrome-device/
**/chrome-device/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Tapture repository hygiene (dev-plan task 001)

# Generated Dart sources are committed so a clean checkout builds directly.

# Android signing material. A key that reaches git is a key that must be rotated.
*.keystore
*.jks
key.properties

# Local environment files. Only the machine that wrote one should ever hold it.
.env
.env.*

# Sample and exported project bundles (app-write-up section 45). They carry
# real field data: records, photos, audio and the audit log behind them.
/samples/
*.bundle.zip
*__*__*.zip
TAPTURE-*.zip

# Speech models are fetched by pinned URL and SHA-256 (tool/speech_models.dart,
# dev-plan task 101); only their generated manifest.json is tracked.
/assets/speech/*.bin
/assets/speech/*.part

# Test suites, with their goldens and fixtures, stay local.
/test/**
/integration_test/
# The same holds for local plugin packages (FE-STR-01), whose native build
# output is regenerated by each platform build.
/packages/*/test/
/packages/*/build/

# Operator-captured photos and other user images. Branding and platform
# icons stay tracked; captured images and failure dumps stay local.
**/photos/
*.jpg
*.jpeg
*.heic
*.heif
*.webp

# Golden comparison dumps. Baselines stay in goldens/; these are local diffs.
**/failures/
**/*_isolatedDiff.png
**/*_maskedDiff.png
**/*_masterImage.png
**/*_testImage.png

