# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.dart_tool/chrome-device/
**/chrome-device/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Tapture repository hygiene (dev-plan 01-orchestration/002)

# Generated sources. Produced by build_runner from the file beside them.
*.g.dart
*.freezed.dart

# Android signing material. A key that reaches git is a key that must be rotated.
*.keystore
*.jks
key.properties

# Local environment files. Only the machine that wrote one should ever hold it.
.env
.env.*

# Sample and exported project bundles (app-write-up section 45). They carry
# real field data: records, photos, audio and the audit log behind them.
/samples/
*.bundle.zip
*__*__*.zip

# Golden comparison dumps. Baselines stay in goldens/; these are local diffs.
**/failures/
**/*_isolatedDiff.png
**/*_maskedDiff.png
**/*_masterImage.png
**/*_testImage.png
